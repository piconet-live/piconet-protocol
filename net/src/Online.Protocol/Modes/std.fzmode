// The standard library of api 1 (piconet-docs research/game-modes/language.md section 9): written in the mode
// language and compiled with every mode file (ModeLibrary.cs). A macro is expanded where a file uses it, its
// arguments put in for its parameters' names; a sub is written where it is called. A use of a word the build does
// not have yet is an error at the use's line, as the same word written in the file would be.

// every(t) { ... }: runs on each multiple of t of the race clock after GO.
macro every(time t, block body) {
  rule { event every step; while race.started and race.steps > 0 and race.steps % t == 0; do body }
}

// at(t) { ... }: once, at t on the race clock.
macro at(time t, block body) {
  rule { event every step; when race.started and race.steps >= t; do body }
}

// lives n: every wreck the game restores (a hit, the energy, a fall, a breakdown) costs one life. The lives remaining
// after this one (the spare machines: 2, 1, 0 with three; 0 with one) show beside the spare-machine icon while the seat
// races (-1, hidden, once it is out); lives_left counts this life too. While a seat has more than one life the game
// restores it; the wreck that leaves it one turns respawns off (the restore under way finishes), so its next wreck is
// final and the game's own out verdict books it. Lives 1 is the game's own rule: no restore at all.
macro lives(int n) {
  seat int lives_left;
  rule { event game_start; do { for each seat { seat.lives_left = n; show_number seat, n - 1; if (n > 1) { respawns seat; } } } }
  rule { event each seat; when seat.restoring; do { seat.lives_left -= 1; if (seat.lives_left <= 1) { respawns seat off; } } }
  rule { event out(s); do { s.lives_left = 0; } }
  rule { event each seat; do {
    if (seat.racing) { show_number seat, max(0, seat.lives_left - 1); } else { show_number seat, -1; }
  } }
}

// pits_off: the pit strips give no energy. A seat in a pit keeps the energy it came in with (less, when it is hit
// there); out of the pits its energy is what the game says.
macro pits_off() {
  seat real pits_off_energy;
  rule { event each seat; do {
    if (seat.in_pit and seat.energy > seat.pits_off_energy) {
      seat.energy = seat.pits_off_energy;
    } else {
      seat.pits_off_energy = seat.energy;
    }
  } }
}

// gap_to(a, b): the distance along the course from a to b, wrapped at the finish line, the shorter way round. From the
// laps' own distances, so a pair takes a tenth of what the whole race's distance and a floor did: thirty seats may each
// look at thirty others in one step (design 9.5).
sub real gap_to(seat a, seat b) {
  real d = abs(a.lap_distance - b.lap_distance);
  return min(d, a.lap_length - d);
}

// dist(a, b): the straight-line distance between two seats.
sub real dist(seat a, seat b) {
  real dx = a.position.x - b.position.x;
  real dy = a.position.y - b.position.y;
  real dz = a.position.z - b.position.z;
  return sqrt(dx * dx + dy * dy + dz * dz);
}

// drive target, brake_cost, surge, plates, gate; -- Twilight's drive (their survival mod, with their permission), for
// every racing seat while `gate` holds (a condition that may name `seat`; `true` for always). It drives the speed the
// machine's engine runs at (seat.base_speed), so the game's grip, slides, slopes, walls and boosts still move the
// machine and the speed shown follows:
// - at its first step a seat's top speed stat goes to 10,000 and its drag to 0, so the game stops pulling the engine's
//   speed down; the machine's own thrust stays, so a full accelerator runs a little above the target;
// - the engine's speed is pulled towards a wanted speed: the target (km/h of the speed shown, made the engine's by
//   base = f + f x f / 125, f = km/h / 216), lowered by the brake (full brake: 0). The accelerator sets how firmly: 1/60
//   of the gap a step coasting, 3/60 at full throttle, down to a tenth of that far above the wanted speed; the brake
//   pulls at 1/60 and takes 0.02 more a step (about 4 km/h);
// - braking costs energy, brake_cost % of Twilight's: more as the target rises and the longer the brake is held (its
//   heat), never taking the energy below 0.1, and at 0.101 or less the brake stops counting;
// - a boost raises the wanted speed by surge % plus 1 % for each point of the game's boost value (seat.boost_value), by
//   how far the accelerator is down: Twilight's is surge 20. A dash plate's boost too when `plates` is on.
// It writes seat.base_speed, seat.energy (braking) and the two stats; a rule of the file may write them after it. The
// top speed of 10,000 needs the file's setup word max_speed_open; (the compiler refuses the mode without it).
macro drive(real target, real brake_cost, real surge, bool plates, bool gate) {
  seat real drive_heat;
  seat int  drive_tuned;
  seat int  drive_was_boosting;
  seat int  drive_plate;
  rule { event each seat; while race.started and seat.racing and gate; do {
    if (seat.drive_tuned == 0) {
      seat.stat.max_speed = 10000.0;
      seat.stat.drag = 0.0;
      seat.drive_tuned = 1;
    }
    real f = target / 216.0;
    real base = f + f * f / 125.0;
    real accel = seat.input.accel;
    real brake = seat.input.brake;
    if (seat.energy <= 0.101) { brake = 0.0; }
    real lose = (brake * base * 0.015 + brake * seat.drive_heat * 0.02) * brake_cost / 100.0;
    if (lose > 0.0) { seat.energy = max(min(seat.energy, 0.1), seat.energy - lose); }
    seat.drive_heat += brake;
    seat.drive_heat = seat.drive_heat * (1.0 - 0.05 * (1.0 - brake));
    if (seat.boosting and seat.drive_was_boosting == 0) {
      seat.drive_plate = 0;
      if (seat.surface == 2) { seat.drive_plate = 1; }
    }
    seat.drive_was_boosting = 0;
    if (seat.boosting) { seat.drive_was_boosting = 1; }
    real wanted = base * (1.0 - brake);
    if (seat.boosting and (plates or seat.drive_plate == 0)) {
      wanted = wanted * (1.0 + (surge / 100.0 + 0.01 * seat.boost_value) * accel);
    }
    real now = seat.base_speed;
    real rate = (1.0 + 2.0 * accel) / 60.0;
    rate = rate * (1.0 - 0.9 * min(max(0.0, now - wanted) * 0.01, 1.0));
    rate = rate + (1.0 / 60.0 - rate) * brake;
    seat.base_speed = max(0.0, now + (wanted - now) * rate - brake * 0.02);
  } }
}
