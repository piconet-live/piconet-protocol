<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The game's limits, the relay's packets and the files' marks, generated by piconet-runner's
         port/facts/generate.py into the protocol's folder (ProtocolGenerated, net/Directory.Build.props: the protocol's own repository moves this
         project up a folder, and its copy of that file names the folder from there). -->
    <Compile Include="$(ProtocolGenerated)GameFacts.g.cs" Link="GameFacts.g.cs" />
    <!-- The relay's UDP packets (RelayProtocol and a record per packet), generated by protocol/generate.py from
         protocol/relay.toml; the game's C++ side includes the header generated beside it. -->
    <Compile Include="$(ProtocolGenerated)RelayPackets.g.cs" Link="RelayPackets.g.cs" />
    <!-- A stat pack's ranges and code constants (StatPackRules.All, StatPackConstants.All), generated by
         protocol/generate.py from protocol/stats.toml; the game's C++ tables are generated beside it. -->
    <Compile Include="$(ProtocolGenerated)StatTables.g.cs" Link="StatTables.g.cs" />
    <!-- A host's rules (HostRules' rules, RaceRules, RaceWords), generated by protocol/generate.py from
         protocol/rules.toml; the game's C++ reader of the rules is generated beside it (race_rules.g.h). -->
    <Compile Include="$(ProtocolGenerated)HostRules.g.cs" Link="HostRules.g.cs" />
    <!-- The courses' names (CourseTable, which CourseNames reads), generated by protocol/generate.py from
         protocol/courses.toml; the game's C++ table is generated beside it (course_names.g.h). -->
    <Compile Include="$(ProtocolGenerated)CourseTable.g.cs" Link="CourseTable.g.cs" />
    <!-- The game modes' vocabulary and bytecode (ModeWords, ModeOp and the word enums; Modes/ModeCompiler reads them),
         generated by protocol/generate.py from protocol/modes.toml; the runner's interpreter includes the header
         generated beside it (mode_words.g.h). -->
    <Compile Include="$(ProtocolGenerated)ModeWords.g.cs" Link="ModeWords.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Quick Play's rotation, quickplay.toml (QuickPlayRotation), which the service and the launcher's stand-in read:
         Tomlyn, BSD-2-Clause. -->
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <!-- The chat's word lists (Chat/ChatWords.cs): the server's always-blocked words and the launcher's swear words.
         Picked from an MIT-licensed list, whose licence goes along with them. -->
    <EmbeddedResource Include="Chat/blocked.txt" LogicalName="Online.Protocol.Chat.blocked.txt" />
    <EmbeddedResource Include="Chat/swears.txt" LogicalName="Online.Protocol.Chat.swears.txt" />
    <EmbeddedResource Include="Chat/LICENSE-profanity-list.txt" LogicalName="Online.Protocol.Chat.LICENSE-profanity-list.txt" />
    <!-- The game modes' standard library (Modes/ModeLibrary.cs), written in the mode language and compiled with every
         mode file (piconet-docs research/game-modes/language.md section 9). -->
    <EmbeddedResource Include="Modes/std.fzmode" LogicalName="Online.Protocol.Modes.std.fzmode" />
  </ItemGroup>

</Project>
