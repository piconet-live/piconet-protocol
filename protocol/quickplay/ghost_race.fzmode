// A ghost race: a time trial raced together. Everyone starts on one spot and nobody touches anybody; you see the
// others as ghosts and your own machine as it is. The results are the game's own, by time.

mode "Ghost race" {
  api 1;
  about "Race the same lap as everyone, through each other, for the best time.";
}

param lap_count "Laps" number 1..9 default 3;

start_together;
contact off;
laps lap_count;

rule "The others are ghosts" {
  event race_start;
  do {
    for each seat {
      seat.look = ghost;
      seat.own_look = normal;
    }
  }
}
