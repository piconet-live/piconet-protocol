// Lap Vote: a demo of a mode's pause (0.6.1). When the first racer finishes lap 1, and again lap 2, the race stands for
// 7 seconds and every player picks: stick left for 10% more top speed, stick right for 20% more boost. The pick is
// applied while the race still stands, and it runs on after a 3, 2, 1. A player who picks nothing keeps their machine.
// Online it would need nothing new: every game stands at the same step and reads the same rows. In 0.6.1 the runner
// races a pausing mode with one player (CPUs allowed).

mode "Lap Vote" {
  api 0.6.1;
  about "Between laps, pick more top speed or more boost.";
}

laps 3;
cpus on;

global int votes;   // the votes held so far
seat int pick;      // this vote's pick: 0 none, 1 top speed, 2 boost

// The first racer into lap 2 or lap 3 stands the race for 7 seconds.
rule "Vote between laps" {
  event lap(s);
  when s.lap >= 1 and s.lap <= 2 and votes < s.lap;
  do {
    votes = s.lap;
    pause;
    say "Pick one: stick left for 10% more top speed, stick right for 20% more boost.";
    wait 7s;
    say off;
    resume after 1s;
  }
}

// Each player's pick, from their stick, until half a second before the vote ends.
rule "Pick" {
  event each seat;
  while race.paused and race.paused_steps < 6.5s and seat.is_human;
  do {
    if (seat.pad.steer < -0.5) { seat.pick = 1; }
    if (seat.pad.steer > 0.5) { seat.pick = 2; }
  }
}

// The pick, applied while the race still stands.
rule "Apply" {
  event each seat;
  when race.paused and race.paused_steps >= 6.5s and seat.pick > 0;
  do {
    if (seat.pick == 1) { seat.stat.max_speed = seat.stat.max_speed * 1.1; }
    if (seat.pick == 2) { seat.stat.boost_strength = seat.stat.boost_strength * 1.2; }
    seat.pick = 0;
  }
}
