// hud_layout ax and hud_move: the race HUD in F-Zero AX's layout, the distance placed under the clock, the faces board
// turned, the spare-machine counter at the bottom centre. Presentation only.
mode "AX HUD" { api 0.6.5; }
hud_layout ax;
rule "Places" {
  event race_start;
  do {
    for each seat {
      show seat, DISTANCE;
      hud_move seat, DISTANCE, 320, 108, 0;
      hud_move seat, FACES, 51, 214, -4.5;
      hud_move seat, SPARE, 320, 444, 0;
    }
  }
}
