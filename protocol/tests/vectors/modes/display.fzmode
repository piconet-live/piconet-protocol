// Every display word of api 1 (vocabulary 5), at least once: a vector for the compiler's tests and the runner's
// interpreter tests (protocol/README.md), not a mode to race. Presentation only: none of these changes the race.

mode "Displays" {
  api 0.6.1;
  about "Every display word of api 1.";
}

seat int lives = 3;

rule "Parts" {
  event every step;
  when race.started;
  do {
    for each seat {
      show seat, TIMER;
      show seat, DISTANCE;
      hide seat, DISTANCE;
    }
  }
}

rule "The number" {
  event each seat;
  do { show_number seat, max(0, seat.lives); }
}

rule "Looks" {
  event each seat;
  when seat.index % 3 == 1;
  do {
    seat.look = ghost;
    seat.own_look = normal;
    map_hide seat from seats - seat;
  }
}

rule "Out of sight" {
  event out(s);
  do {
    s.look = invisible;
    s.colour = 0xFF2020FF;
    map_mark s, 0xFF0000;
    tag s off;
    tag s, "OUT", size 0.4 1, range 300 m;   // (0.6.1: its settings on the word: 0.4 to 1 of a name tag, full to 225 m, gone at 300)
    stock_banner s, FINAL_LAP;
    show_number s, -1;
  }
}

rule "The owner's words of 2026-10-31" {
  event finish(s);
  do {
    show_number s off;
    show s, GHOST_GAP;
    hide s, GHOST_GAP;
    s.ghost_tint = 0x80FF80FF;
    s.ghost_sound = on;
    s.ghost_sound = off;
  }
}

rule "The story parts' values" {
  event lap(s);
  do {
    show_distance s, s.lap_length - s.lap_distance;
    show s, DISTANCE;
    show_objects s, s.lap, 5;
    show s, OBJECTS;
    show_distance s off;
    show_objects s off;
  }
}

rule "A part moved" {
  event lap(s);
  do {
    hud_move s, RANK, 24.5, 412, 90;
    hud_move s, RANK off;
    show_score s, 1234567;
    show_score s, -5, "KOS";
    hud_move s, SCORE, 320, 100, 0;
    show_score s off;
    show_score s, 3, "KOS", CAPS;
    show_text s, "GO";
    show_text s, "WAVE 2", BIG_SERIF;
    hud_move s, TEXT, 320, 400, 180;
    show_text s off;
  }
}

rule "Map characters" {
  event lap(s);
  do {
    map_char s, "K";
    map_char s, "♛";
    map_char s, CROWN;
    map_char s off;
  }
}
