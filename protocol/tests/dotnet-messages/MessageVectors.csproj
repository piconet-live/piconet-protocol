<Project Sdk="Microsoft.NET.Sdk">
  <!-- The lobby link's messages (../../messages.toml) against Online.Protocol's records, which System.Text.Json writes
       and reads: the schema (every record's members, types, defaults and omissions, the message types' names) equals
       the records' (../../generated/LobbySchema.g.cs, from messages.toml); the vectors (../vectors/messages) are the
       records' bytes; what the C++ codec (../cxx/test_lobby_messages.cpp) wrote decodes and writes again to the same
       bytes in C#. Run by protocol/check.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../generated/LobbySchema.g.cs" Link="Generated/LobbySchema.g.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../net/src/Online.Protocol/Online.Protocol.csproj" />
  </ItemGroup>
</Project>
